// x16 "Hiring a Zoomer" (script v3, 2026-10-27, docs/x16-hiring-a-zoomer.md). Ross: "the interview with a zoomer, yes - the main thing is that the first shot is something like hiring a zoomer, something that puts the viewer in the context at once, like a POV".
// Ross interviews Kenzie (22), who livestreams it through a ring light and plants a red flag on every boss cliché; her mom negotiates on the live; he blows, hires her anyway, and that gets a flag too.
// Ross is jack-tyler (as in x08-x15), Kenzie Laura (young, sassy), Mom Jessica Anne Bogart (crisp, cold). No swearing in this one.
// Format: see scripts/voice-gen.mjs (lines, directions) and scripts/voice-build.py (cast, plan, gaps, lead, tableSfx). Take k of a line uses direction k.
{
 "title": "Hiring a Zoomer",
 "cast": {"ross": 1, "kenzie": 1, "mom": 1},
 "runnerUp": {},
 "lines": [
// to her phone on the ring light, as the light clicks on in his face
  {"n": 1, "char": "kenzie", "text": "Hi chat.", "dirs": [
   {"t": "[bored] [flat]", "st": 0.55, "sy": 0.3},
   {"t": "[deadpan] [vocal fry]", "st": 0.5, "sy": 0.35},
   {"t": "[unimpressed] [monotone]", "st": 0.6, "sy": 0.25}
  ]},
// squinting into the light, his best boss smile
  {"n": 2, "char": "ross", "text": "So, we're like a family here.", "dirs": [
   {"t": "[warm] [salesy]", "st": 0.4, "sy": 0.55},
   {"t": "[cheerful] [proud]", "st": 0.4, "sy": 0.55},
   {"t": "[friendly] [smug]", "st": 0.45, "sy": 0.5}
  ]},
// planting a toothpick flag in his coffee
  {"n": 3, "char": "kenzie", "text": "Red flag.", "dirs": [
   {"t": "[deadpan] [flat]", "st": 0.55, "sy": 0.3},
   {"t": "[unimpressed] [matter-of-fact]", "st": 0.5, "sy": 0.35},
   {"t": "[bored] [dismissive]", "st": 0.55, "sy": 0.3}
  ]},
// casual, like it's nothing
  {"n": 4, "char": "ross", "text": "First shift's a free trial.", "dirs": [
   {"t": "[casual] [upbeat]", "st": 0.45, "sy": 0.45},
   {"t": "[breezy] [confident]", "st": 0.45, "sy": 0.45},
   {"t": "[cheerful] [offhand]", "st": 0.4, "sy": 0.5}
  ]},
// one eyebrow up
  {"n": 5, "char": "kenzie", "text": "Unpaid?", "dirs": [
   {"t": "[suspicious] [flat]", "st": 0.5, "sy": 0.4},
   {"t": "[skeptical] [unimpressed]", "st": 0.5, "sy": 0.4},
   {"t": "[incredulous] [dry]", "st": 0.45, "sy": 0.45}
  ]},
// sipping her tumbler, unbothered
  {"n": 6, "char": "kenzie", "text": "Can I do it remote?", "dirs": [
   {"t": "[casual] [unbothered]", "st": 0.5, "sy": 0.35},
   {"t": "[nonchalant] [vocal fry]", "st": 0.5, "sy": 0.35},
   {"t": "[lazy] [hopeful]", "st": 0.45, "sy": 0.4}
  ]},
// the smile frozen, dead flat
  {"n": 7, "char": "ross", "text": "It's a coffee shop.", "dirs": [
   {"t": "[deadpan] [flat]", "st": 0.6, "sy": 0.25},
   {"t": "[stunned] [monotone]", "st": 0.55, "sy": 0.3},
   {"t": "[dry] [barely holding it together]", "st": 0.5, "sy": 0.35}
  ]},
// spinning the phone around to him
  {"n": 8, "char": "kenzie", "text": "My mom handles the money.", "dirs": [
   {"t": "[matter-of-fact] [casual]", "st": 0.5, "sy": 0.35},
   {"t": "[flat] [unbothered]", "st": 0.55, "sy": 0.3},
   {"t": "[breezy] [smug]", "st": 0.45, "sy": 0.4}
  ]},
// on the live: a cold negotiator reading terms
  {"n": 9, "char": "mom", "text": "She needs thirty an hour. And she doesn't do mornings.", "dirs": [
   {"t": "[crisp] [businesslike]", "st": 0.5, "sy": 0.4},
   {"t": "[cold] [firm]", "st": 0.55, "sy": 0.35},
   {"t": "[condescending] [calm]", "st": 0.5, "sy": 0.4}
  ]},
// an afterthought
  {"n": 10, "char": "mom", "text": "Or customers.", "dirs": [
   {"t": "[offhand] [cold]", "st": 0.5, "sy": 0.4},
   {"t": "[matter-of-fact] [dismissive]", "st": 0.55, "sy": 0.35},
   {"t": "[casual] [firm]", "st": 0.5, "sy": 0.4}
  ]},
// the thumb back at the line of customers, losing it
  {"n": 11, "char": "ross", "text": "IT'S A COFFEE SHOP!", "dirs": [
   {"t": "[furious] [shouting]", "st": 0.25, "sy": 0.8},
   {"t": "[screaming] [exasperated]", "st": 0.2, "sy": 0.85},
   {"t": "[enraged] [yelling]", "st": 0.25, "sy": 0.8}
  ]},
// her arm out of the phone, the flagpole on his head
  {"n": 12, "char": "mom", "text": "No, honey. YOU'RE the red flag.", "dirs": [
   {"t": "[calm] [condescending]", "st": 0.5, "sy": 0.45},
   {"t": "[cold] [sweetly cruel]", "st": 0.45, "sy": 0.5},
   {"t": "[patronizing] [firm]", "st": 0.5, "sy": 0.45}
  ]},
// sipping, after the storm
  {"n": 13, "char": "kenzie", "text": "So... when do I start?", "dirs": [
   {"t": "[casual] [unbothered]", "st": 0.5, "sy": 0.35},
   {"t": "[nonchalant] [chewing]", "st": 0.5, "sy": 0.35},
   {"t": "[bored] [hopeful]", "st": 0.5, "sy": 0.35}
  ]},
// through his teeth, steaming
  {"n": 14, "char": "ross", "text": "You're hired.", "dirs": [
   {"t": "[through gritted teeth] [strained]", "st": 0.35, "sy": 0.6},
   {"t": "[defeated] [seething]", "st": 0.4, "sy": 0.55},
   {"t": "[tense] [forced calm]", "st": 0.4, "sy": 0.55}
  ]},
// after a beat, planting one more flag
  {"n": 15, "char": "kenzie", "text": "...Red flag.", "dirs": [
   {"t": "[deadpan] [flat]", "st": 0.55, "sy": 0.3},
   {"t": "[unimpressed] [slow]", "st": 0.55, "sy": 0.3},
   {"t": "[bored] [dismissive]", "st": 0.5, "sy": 0.35}
  ]}
 ],
