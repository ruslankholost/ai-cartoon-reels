   {"t": "[urgent whisper]", "st": 0.35, "sy": 0.5, "text": "Ma'am... stop flushing. [yelling] STOP! FLUSHING!"},
   {"t": "[hushed]", "st": 0.35, "sy": 0.5, "text": "Ma'am. Stop flushing. [panicked] [shouting] STOP FLUSHING!"}
  ]},
// the dentist: "Dave's Plumbing" with the mouth wide open, so no lip sounds
