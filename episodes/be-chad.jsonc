   {"t": "[proud] [smooth]", "st": 0.4, "sy": 0.45},
   {"t": "[cocky] [winking]", "st": 0.4, "sy": 0.5}
  ]},
// 6 Take: day six with no sleep, he dozes off under Linda's sink, the pipe bursts, Linda is on the flamingo again
  {"n": 15, "char": "linda", "text": "Dave?", "dirs": [
   {"t": "[worried] [quiet]", "st": 0.4, "sy": 0.35, "text": "...Dave?"},
   {"t": "[nervous] [softly]", "st": 0.4, "sy": 0.35},
   {"t": "[concerned]", "st": 0.4, "sy": 0.3}
  ]},
// Barb's note on the fridge, read in her voice
  {"n": 16, "char": "barb", "text": "At my sister's. Call me. Oh wait.", "dirs": [
   {"t": "[flat] [deadpan]", "st": 0.5, "sy": 0.15},
   {"t": "[dry] [unimpressed]", "st": 0.45, "sy": 0.25, "text": "At my sister's. Call me... Oh, wait."},
   {"t": "[deadpan]", "st": 0.5, "sy": 0.1, "text": "At my sister's. Call me. ... Oh wait."}
  ]},
