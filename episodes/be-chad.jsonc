  ]},
// 5 Find: the calendar is full till Christmas
  {"n": 13, "char": "linda", "text": "Dave? You actually picked up!", "dirs": [
   {"t": "[surprised] [delighted]", "st": 0.35, "sy": 0.5},
   {"t": "[shocked] [happy]", "st": 0.35, "sy": 0.5},
   {"t": "[amazed]", "st": 0.35, "sy": 0.45}
  ]},
  {"n": 14, "char": "dave", "text": "First ring, baby.", "dirs": [
