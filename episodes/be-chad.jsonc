// hook
  {"id": "s01", "at": 0.0, "kind": "move", "refs": ["dave"], "key": "Night, a dark bedroom lit only by moonlight from a window, a double bed with a wooden headboard. A big mound moves under the quilt; the bald plumber with the thick brown mustache, shirtless, no overalls, peeks out from under the quilt, sweaty, reaching toward a smartphone that glows and rings on the nightstand. Only his head, a bare shoulder and his bare arm show.", "move": "the quilt bumps and shifts, he slowly reaches out and picks up the phone from the nightstand, no sparks, no electricity", "seed": 8},
  {"id": "s02", "at": 1.9, "kind": "talk", "who": "dave", "refs": ["dave"], "key": "Night, a dark bedroom lit by the blue glow of a smartphone. Close-up: the bald plumber with the thick brown mustache lies in bed under a quilt pulled up to his chest, bare shoulders, sweaty forehead, out of breath, holding a smartphone to his ear with an eager professional grin.", "move": "he talks into the phone out of breath, with an eager grin"},
  {"id": "s03", "at": 4.45, "kind": "talk", "who": "barb", "refs": ["barb"], "key": "Night, a dark bedroom lit by moonlight. The woman with brown hair in a bun and gold wire glasses lies in bed on her back, the quilt pulled up to her chin, a light blue nightgown, staring at the ceiling with a flat, unimpressed face.", "move": "she says something dry without moving her head, eyes on the ceiling"},
