   {"t": "[out of breath] [professional]", "st": 0.4, "sy": 0.4},
   {"t": "[panting] [cheerful]", "st": 0.35, "sy": 0.5, "text": "Dave's Plumbing... how fast can I come?"}
  ]},
  {"n": 2, "char": "barb", "text": "Never been a problem for you.", "dirs": [
   {"t": "[flat] [deadpan]", "st": 0.5, "sy": 0.15},
   {"t": "[dry] [unimpressed]", "st": 0.45, "sy": 0.25},
   {"t": "[deadpan] [muttering]", "st": 0.5, "sy": 0.15}
  ]},
// 1 You: the kitchen, Monday morning, Dave reads Chad's reviews out loud
  {"n": 3, "char": "dave", "text": "Picked up in one minute. Chad's my hero.", "dirs": [
   {"t": "[mocking] [sing-song]", "st": 0.3, "sy": 0.5},
   {"t": "[sarcastic] [whiny]", "st": 0.35, "sy": 0.5},
   {"t": "[reading aloud] [mocking]", "st": 0.35, "sy": 0.45}
  ]},
  {"n": 4, "char": "dave", "text": "Chad can go fuck himself.", "dirs": [
   {"t": "[bitter] [muttering]", "st": 0.45, "sy": 0.3},
   {"t": "[annoyed] [under his breath]", "st": 0.45, "sy": 0.3},
   {"t": "[grumbling]", "st": 0.45, "sy": 0.25}
  ]},
// 2 Need
  {"n": 5, "char": "dave", "text": "That's it. I pick up every call. First ring.", "dirs": [
   {"t": "[determined]", "st": 0.4, "sy": 0.4},
   {"t": "[fired up] [loud]", "st": 0.35, "sy": 0.5},
   {"t": "[resolute] [proud]", "st": 0.4, "sy": 0.45, "text": "That's it. I pick up every call... First ring."}
  ]},
// Barb does not look up from the bills (the pilot's "Mm-hm" was "[unimpressed] Mhm.")
  {"n": 6, "char": "barb", "text": "Mm-hm.", "dirs": [
   {"t": "[unimpressed]", "st": 0.5, "sy": 0.15, "text": "Mhm."},
   {"t": "[flat] [deadpan]", "st": 0.5, "sy": 0.15},
   {"t": "[bored]", "st": 0.5, "sy": 0.15, "text": "Mhm."}
  ]},
// 3 Go: the phone taped to his palm, the tape rips the hair off his arm
  {"n": 7, "char": "dave", "text": "Aaah, fuck!", "dirs": [
   {"t": "[yelps in pain]", "st": 0.3, "sy": 0.5},
   {"t": "[screaming in pain]", "st": 0.3, "sy": 0.6},
   {"t": "[pained]", "st": 0.35, "sy": 0.5, "text": "Aaaah! Fuck!"}
  ]},
  {"n": 8, "char": "dave", "text": "Nobody waits on Dave.", "dirs": [
   {"t": "[proud] [smug]", "st": 0.4, "sy": 0.45},
   {"t": "[proudly] [teary]", "st": 0.35, "sy": 0.45},
   {"t": "[proud] [through gritted teeth]", "st": 0.4, "sy": 0.4}
  ]},
// 4 Search: the shower (sparks, he gets a shock), the school play, the dentist, 3 AM
  {"n": 9, "char": "dave", "text": "Dave's Plumbing!", "dirs": [
   {"t": "[cheerful] [shouting]", "st": 0.35, "sy": 0.5},
   {"t": "[eager] [loud]", "st": 0.35, "sy": 0.5},
   {"t": "[cheerful]", "st": 0.4, "sy": 0.45}
  ]},
  {"n": 10, "char": "dave", "text": "Ma'am. Stop flushing. STOP FLUSHING.", "dirs": [
