// x19 "Screen Time", Part 2 of x18 "Unattended" (script v3, 2026-10-29, docs/x19-screen-time.md). Ross 10-29: "so what about the new video, which one are we making? the kids one actually took off, 10k views".
// The mom and the toddler from x18 are back: his tablet blasts a kids' song in Ross's café; every polite fix makes her bring a bigger screen (the stroller's canopy is a TV),
// the customers glaze over, Ross dims the lights and sells popcorn; the screen dies at 1%, she whispers for a charger and Ross sells her one: "Six fifty."
// Ross is jack-tyler (as in x08-x18) and never shouts here: line 1 is said up over the song, politely. The mom is Sarah (x18's mom).
// The toddler's two whimpers are sounds, not lines (scratch/sfx-raw/x19-whimper*): a pitched-up adult "mmm" can't be judged without ears, a sound-effect child can. Their time is in gaps 6 and 11.
// The takes were made with the whimpers as lines 7 and 13 (their takes are in scratch/voice-raw/x19-unused); the later lines were renumbered and their raw files renamed to match.
// Line 4 is cut off by Ross's "...No." (gap 0).
// Format: see scripts/voice-gen.mjs (lines, directions) and scripts/voice-build.py (cast, plan, gaps, lead, tableSfx). Take k of a line uses direction k.
{
 "title": "Screen Time",
 "cast": {"ross": 1, "mom": 3},
 "runnerUp": {},
 "lines": [
// behind the counter, his hair blown back by the blast; polite, said up over the song
  {"n": 1, "char": "ross", "text": "Could you turn it down a bit?", "dirs": [
   {"t": "[polite] [raising his voice over loud music]", "st": 0.5, "sy": 0.35},
   {"t": "[friendly] [loud]", "st": 0.5, "sy": 0.35},
   {"t": "[strained] [polite] [loud]", "st": 0.5, "sy": 0.4}
  ]},
// scrolling her own phone, not looking up
  {"n": 2, "char": "mom", "text": "He needs it to eat.", "dirs": [
   {"t": "[dismissive] [distracted]", "st": 0.45, "sy": 0.5},
   {"t": "[breezy] [matter-of-fact]", "st": 0.45, "sy": 0.5},
   {"t": "[bored] [not paying attention]", "st": 0.5, "sy": 0.45}
  ]},
// the muffin hops across the plate on the bass
  {"n": 3, "char": "ross", "text": "He's not eating.", "dirs": [
   {"t": "[flat]", "st": 0.6, "sy": 0.25},
   {"t": "[deadpan] [quiet]", "st": 0.6, "sy": 0.25},
   {"t": "[dry] [matter-of-fact]", "st": 0.55, "sy": 0.3}
  ]},
// cut off by Ross
  {"n": 4, "char": "mom", "text": "Do you have—", "dirs": [
   {"t": "[condescending]", "st": 0.45, "sy": 0.5},
   {"t": "[smug] [casual]", "st": 0.45, "sy": 0.5},
   {"t": "[patronizing] [fast]", "st": 0.5, "sy": 0.45}
  ]},
// he knows the question by now
  {"n": 5, "char": "ross", "text": "...No.", "dirs": [
   {"t": "[flat] [cutting in]", "st": 0.6, "sy": 0.25},
   {"t": "[deadpan] [quick]", "st": 0.6, "sy": 0.25},
   {"t": "[dry]", "st": 0.55, "sy": 0.3}
  ]},
  {"n": 6, "char": "mom", "text": "Then you wouldn't understand.", "dirs": [
   {"t": "[smug] [sing-song]", "st": 0.4, "sy": 0.55},
   {"t": "[condescending] [sweet]", "st": 0.45, "sy": 0.5},
   {"t": "[dismissive] [knowing]", "st": 0.45, "sy": 0.5}
  ]},
// Ross turned the volume down one notch, the toddler whimpered: her head snaps up from her phone
  {"n": 7, "char": "mom", "text": "No no no no NO!", "dirs": [
   {"t": "[panicked] [fast]", "st": 0.3, "sy": 0.7},
   {"t": "[alarmed] [rushing]", "st": 0.3, "sy": 0.7},
   {"t": "[frantic]", "st": 0.35, "sy": 0.65}
  ]},
// he holds out a pair of tiny kids' headphones, calm
  {"n": 8, "char": "ross", "text": "Headphones?", "dirs": [
   {"t": "[calm] [helpful]", "st": 0.55, "sy": 0.3},
   {"t": "[polite] [offering]", "st": 0.55, "sy": 0.3},
   {"t": "[gentle] [hopeful]", "st": 0.55, "sy": 0.3}
  ]},
  {"n": 9, "char": "mom", "text": "He HATES headphones!", "dirs": [
   {"t": "[snapping] [annoyed]", "st": 0.35, "sy": 0.65},
   {"t": "[outraged] [loud]", "st": 0.3, "sy": 0.7},
   {"t": "[irritated] [sharp]", "st": 0.4, "sy": 0.6}
  ]},
// the café dimmed, a paper usher's hat on, a popcorn bucket up
  {"n": 10, "char": "ross", "text": "...Popcorn?", "dirs": [
   {"t": "[calm] [like a cinema usher]", "st": 0.55, "sy": 0.3},
   {"t": "[cheerful] [businesslike]", "st": 0.5, "sy": 0.35},
   {"t": "[dry] [offering]", "st": 0.55, "sy": 0.3}
  ]},
// the toddler munches popcorn
  {"n": 11, "char": "mom", "text": "See? He's eating!", "dirs": [
   {"t": "[delighted] [smug]", "st": 0.4, "sy": 0.6},
   {"t": "[proud] [triumphant]", "st": 0.4, "sy": 0.6},
   {"t": "[thrilled] [vindicated]", "st": 0.4, "sy": 0.6}
  ]},
// the screen died at 1% and his lip trembles again
  {"n": 12, "char": "mom", "text": "...Charger?", "dirs": [
   {"t": "[terrified] [whispering]", "st": 0.45, "sy": 0.5},
   {"t": "[whispers] [panicked]", "st": 0.45, "sy": 0.5},
   {"t": "[hushed] [desperate]", "st": 0.5, "sy": 0.45}
  ]},
// he takes one off the rack and slides it across the counter
  {"n": 13, "char": "ross", "text": "Six fifty.", "dirs": [
   {"t": "[calm] [dry]", "st": 0.6, "sy": 0.25},
   {"t": "[deadpan] [matter-of-fact]", "st": 0.6, "sy": 0.25},
   {"t": "[businesslike] [calm]", "st": 0.55, "sy": 0.3}
  ]}
 ],
// takes picked from voice-analyze and Whisper (all 39 heard): Ross's loudest polite ask (t1), her flattest "eat" (t1), Ross's flattest "not eating" (t1), her fast rising cut-off "have—" (t3),
// his quickest "No." (t2), the fast knowing "understand" (t3, as x18 picked), her highest frantic "NO!" (t3), his rising "Headphones?" (t2; t1 was heard as a statement), her loudest "HATES" (t2),
// his businesslike usher "Popcorn?" (t2; t1 ends on a swell), her loudest "eating!" (t3, the only one heard with "!"), the panicked whisper (t2), his flattest "Six fifty." (t2).
// The first build ran 31.7 s, so six lines are 1.1 times faster and the gaps for the pictures are tighter (the reel has to stay near 30 s)
 "plan": {"1": {"t": 1, "rate": 1.1}, "2": {"t": 1, "rate": 1.1}, "3": {"t": 1}, "4": {"t": 3}, "5": {"t": 2}, "6": {"t": 3, "rate": 1.1}, "7": {"t": 3, "rate": 1.1}, "8": {"t": 2}, "9": {"t": 2, "rate": 1.1}, "10": {"t": 2},
  "11": {"t": 3, "rate": 1.1}, "12": {"t": 2}, "13": {"t": 2}},
// lead and gaps place the speech on the reel's clock: the tablet, Ross in the blast and the toddler before line 1; the muffin hop after 2; Ross cuts her off (4-5);
// the volume tap, the song's dip and the first whimper after 6; the bar shooting off the screen and the headphones after 7; the stroller TV, the windows, the customers,
// the CLICK and the hat after 9; the cash and the munching after 10; the 1%, the black, the silence and the second whimper after 11; the charger off the rack after 12
 "lead": 1.5,
 "gaps": {"1": 0.3, "2": 0.45, "3": 0.25, "4": 0.0, "5": 0.3, "6": 1.8, "7": 0.8, "8": 0.2, "9": 3.0, "10": 1.1, "11": 3.0, "12": 0.6},
 "tableSfx": []
}
