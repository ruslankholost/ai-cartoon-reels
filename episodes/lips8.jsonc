   {"t": "[hysterical] [screaming]", "st": 0.2, "sy": 0.75}
  ]},
// Todd on the floor after the belly-flop, scrubbing the one drop on her shoe
  {"n": 2, "char": "todd", "text": "Ma'am! Did any get on you?", "dirs": [
   {"t": "[panicked] [high-pitched] [breathless]", "st": 0.25, "sy": 0.6},
   {"t": "[frantic] [fussing] [terrified]", "st": 0.25, "sy": 0.6},
   {"t": "[horrified] [overeager] [voice cracking]", "st": 0.3, "sy": 0.55},
   {"t": "[hysterical] [screaming] [panicked]", "st": 0.2, "sy": 0.75, "text": "MA'AM! Did any get on YOU?!"},
   {"t": "[shrieking] [horrified] [voice cracking]", "st": 0.2, "sy": 0.8, "text": "MA'AM! Did any get on YOU?!"},
   {"t": "[hysterical] [frantic] [high-pitched]", "st": 0.15, "sy": 0.8, "text": "MA'AM! Did any get on YOU?!"}
  ]},
  {"n": 3, "char": "customer", "text": "I want my money back.", "dirs": [
   {"t": "[cold] [slow] [menacing]", "st": 0.35, "sy": 0.5},
   {"t": "[icy] [entitled] [slow]", "st": 0.35, "sy": 0.55},
   {"t": "[calm] [cruel]", "st": 0.4, "sy": 0.5}
  ]},
  {"n": 4, "char": "customer", "text": "And my tip.", "dirs": [
   {"t": "[cold] [pointed]", "st": 0.35, "sy": 0.5},
   {"t": "[entitled] [icy]", "st": 0.35, "sy": 0.55},
   {"t": "[smug] [slow]", "st": 0.4, "sy": 0.5}
  ]},
  {"n": 5, "char": "denise", "text": "You didn't tip.", "dirs": [
