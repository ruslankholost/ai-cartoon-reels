   {"t": "[begging] [panicked]", "st": 0.3, "sy": 0.5},
   {"t": "[frantic] [whimpering]", "st": 0.35, "sy": 0.45},
   {"t": "[begging] [voice cracking] [desperate]", "st": 0.2, "sy": 0.7},
   {"t": "[shrieking] [pleading]", "st": 0.2, "sy": 0.75},
