   {"t": "[flat] [restrained anger]", "st": 0.4, "sy": 0.4},
   {"t": "[dry] [weary] [incredulous]", "st": 0.45, "sy": 0.35}
  ]},
// she leans over the counter into Denise's face
  {"n": 6, "char": "customer", "text": "I tipped in my head.", "dirs": [
   {"t": "[matter-of-fact] [smug]", "st": 0.35, "sy": 0.55},
   {"t": "[condescending] [slow]", "st": 0.35, "sy": 0.55},
   {"t": "[self-satisfied] [cold]", "st": 0.4, "sy": 0.5},
   {"t": "[whispering] [smug] [slow]", "st": 0.35, "sy": 0.55, "text": "I tipped... in my head."},
   {"t": "[whispers] [condescending]", "st": 0.35, "sy": 0.6, "text": "I tipped... in my head."},
   {"t": "[softly] [whispering] [cold]", "st": 0.4, "sy": 0.5, "text": "I tipped... in my head."}
  ]},
// Todd shoves the DENISE / TIPS jar into her arms
  {"n": 7, "char": "todd", "text": "Take Denise's!", "dirs": [
