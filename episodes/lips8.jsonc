   {"t": "[purring] [condescending]", "st": 0.3, "sy": 0.6, "text": "Anything? ...Then rub my feet."},
   {"t": "[sly] [amused] [cruel]", "st": 0.3, "sy": 0.6, "text": "Anything? ...Then rub my feet."},
   {"t": "[slow] [smug] [imperious]", "st": 0.4, "sy": 0.5, "text": "Anything? ...Then rub my feet."}
  ]},
// Todd rubs her foot until it smokes; she melts
  {"n": 12, "char": "customer", "text": "Ohhh.", "dirs": [
