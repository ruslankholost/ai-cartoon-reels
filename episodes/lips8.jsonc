   {"t": "[flat] [exasperated]", "st": 0.4, "sy": 0.4},
   {"t": "[dry] [genuinely asking]", "st": 0.45, "sy": 0.35},
   {"t": "[exploding] [screaming] [furious]", "st": 0.2, "sy": 0.75, "text": "THEN WHY ARE YOU HERE?!"},
   {"t": "[yelling] [snapping] [enraged]", "st": 0.2, "sy": 0.8, "text": "THEN WHY ARE YOU HERE?!"},
   {"t": "[screaming] [losing it]", "st": 0.15, "sy": 0.8, "text": "THEN WHY ARE YOU HERE?!"}
  ]},
// Todd's hands over Denise's mouth
  {"n": 10, "char": "todd", "text": "Ma'am, anything!", "dirs": [
