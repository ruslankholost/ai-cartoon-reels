   {"t": "[falsetto] [shrieking] [panicked]", "st": 0.2, "sy": 0.8, "text": "MA'AM! ANYTHING!"},
   {"t": "[high-pitched] [screaming] [desperate]", "st": 0.2, "sy": 0.8, "text": "MA'AM! ANYTHING!"},
   {"t": "[shrieking] [voice cracking] [begging]", "st": 0.15, "sy": 0.8, "text": "MA'AM! ANYTHING!"}
  ]},
// a thin smile; her bare foot comes up onto the counter after it
  {"n": 11, "char": "customer", "text": "Anything? Then rub my feet.", "dirs": [
   {"t": "[amused] [sly] [slow]", "st": 0.35, "sy": 0.5},
   {"t": "[smug] [commanding]", "st": 0.35, "sy": 0.55},
