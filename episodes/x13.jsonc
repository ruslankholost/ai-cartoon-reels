// x13 "Cheaper" (script v2, 2026-10-26, docs/x13-cheaper.md). Ross: "Now let's go back and make one more reel about small business", idea 3 of docs/ideas-small-business-owners.md.
// Chuck spits out his coffee at the price; Ross, smiling through it, cuts it to free, pays him five, then hands him the shop; behind the counter Chuck charges twelve, and when Ross spits it out he makes it thirteen.
// Ross is jack-tyler (as in x08-x12), Chuck jack-chris-boston (as in x10-x12).
// Format: see scripts/voice-gen.mjs (lines, directions) and scripts/voice-build.py (cast, plan, gaps, lead, tableSfx). Take k of a line uses direction k.
{
 "title": "Cheaper",
 "cast": {"ross": 1, "chuck": 1},
 "runnerUp": {},
 "lines": [
// after his spit-take, his face purple, stabbing a finger at the display
  {"n": 1, "char": "chuck", "text": "FIVE BUCKS?! For COFFEE?!", "dirs": [
   {"t": "[outraged] [shouting]", "st": 0.25, "sy": 0.8},
   {"t": "[appalled] [yelling]", "st": 0.25, "sy": 0.8},
   {"t": "[furious] [loud]", "st": 0.3, "sy": 0.75}
  ]},
// dripping coffee, the service smile still on, his eye twitching
  {"n": 2, "char": "ross", "text": "...Four?", "dirs": [
   {"t": "[forced cheerful] [through gritted teeth]", "st": 0.45, "sy": 0.45},
   {"t": "[nervous] [polite]", "st": 0.5, "sy": 0.4},
   {"t": "[strained] [hopeful]", "st": 0.45, "sy": 0.45}
  ]},
  {"n": 3, "char": "chuck", "text": "My cousin sells it for two.", "dirs": [
   {"t": "[smug] [matter-of-fact]", "st": 0.4, "sy": 0.55},
   {"t": "[dismissive] [casual]", "st": 0.45, "sy": 0.5},
   {"t": "[sneering] [flat]", "st": 0.4, "sy": 0.55}
  ]},
// the vein throbbing, the smile stretching wider
  {"n": 4, "char": "ross", "text": "One-fifty!", "dirs": [
   {"t": "[eager] [strained cheerful]", "st": 0.35, "sy": 0.6},
   {"t": "[desperate] [quick]", "st": 0.35, "sy": 0.6},
   {"t": "[overly enthusiastic]", "st": 0.3, "sy": 0.65}
  ]},
// holding up his phone, offering a favour
  {"n": 5, "char": "chuck", "text": "I'll post about you. I got forty followers.", "dirs": [
   {"t": "[proud] [generous]", "st": 0.4, "sy": 0.55},
   {"t": "[smug] [bragging]", "st": 0.4, "sy": 0.55},
   {"t": "[self-important] [casual]", "st": 0.45, "sy": 0.5}
  ]},
// eyes bulging, a huge clenched grin, arms flung wide, the first whistle of steam
  {"n": 6, "char": "ross", "text": "FREE!!", "dirs": [
   {"t": "[manic] [shouting]", "st": 0.2, "sy": 0.85},
   {"t": "[hysterical] [cheerful]", "st": 0.2, "sy": 0.85},
   {"t": "[unhinged] [yelling]", "st": 0.25, "sy": 0.8}
  ]},
// after a slow sip, unimpressed
  {"n": 7, "char": "chuck", "text": "What else do I get?", "dirs": [
   {"t": "[unimpressed] [flat]", "st": 0.5, "sy": 0.35},
   {"t": "[entitled] [casual]", "st": 0.45, "sy": 0.4},
   {"t": "[bored] [demanding]", "st": 0.5, "sy": 0.35}
  ]},
// holding out a five-dollar bill, his hand shaking
  {"n": 8, "char": "ross", "text": "Five bucks?", "dirs": [
   {"t": "[desperate] [shaky]", "st": 0.4, "sy": 0.5},
   {"t": "[whimpering] [pleading]", "st": 0.4, "sy": 0.5},
   {"t": "[nervous] [small voice]", "st": 0.45, "sy": 0.45}
  ]},
// looking at the bill
  {"n": 9, "char": "chuck", "text": "...That's it?", "dirs": [
   {"t": "[unimpressed] [disappointed]", "st": 0.5, "sy": 0.35},
   {"t": "[flat] [entitled]", "st": 0.5, "sy": 0.35},
   {"t": "[scoffing] [bored]", "st": 0.45, "sy": 0.4}
  ]},
// the corks, the kettle: the drawer, the keys, the apron
  {"n": 10, "char": "ross", "text": "TAKE IT!! TAKE IT ALL!!", "dirs": [
   {"t": "[screaming] [unhinged]", "st": 0.2, "sy": 0.85},
   {"t": "[enraged] [screaming]", "st": 0.2, "sy": 0.85},
   {"t": "[hysterical] [shouting]", "st": 0.25, "sy": 0.8}
  ]},
// the next day, on the customer side, right after his own spit-take
  {"n": 11, "char": "ross", "text": "TWELVE?!", "dirs": [
   {"t": "[outraged] [choking]", "st": 0.25, "sy": 0.8},
   {"t": "[appalled] [shouting]", "st": 0.25, "sy": 0.8},
   {"t": "[shocked] [yelling]", "st": 0.3, "sy": 0.75}
  ]},
// behind the counter in Ross's apron, dripping, tapping a key
  {"n": 12, "char": "chuck", "text": "...Thirteen.", "dirs": [
   {"t": "[deadpan] [calm]", "st": 0.55, "sy": 0.25},
   {"t": "[flat] [unbothered]", "st": 0.55, "sy": 0.25},
   {"t": "[dry] [matter-of-fact]", "st": 0.5, "sy": 0.3}
  ]}
 ],
 "plan": {"1": {"t": 1, "rate": 1.1}, "2": {"t": 1, "rate": 1.15}, "3": {"t": 2}, "4": {"t": 1, "rate": 1.15}, "5": {"t": 2, "rate": 1.15}, "6": {"t": 1}, "7": {"t": 1}, "8": {"t": 1, "rate": 1.15}, "9": {"t": 1}, "10": {"t": 1, "rate": 1.05}, "11": {"t": 1}, "12": {"t": 1}},
