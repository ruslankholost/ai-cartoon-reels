 "shots": [
  {"id": "a01", "at": 0.0, "kind": "still", "key": "Close-up of the door of an old rusty pickup truck whose door has a long row of freshly spray-painted black capital letters AAAAAAAAAAAA running across it, the faded words & SON below, in a sunny suburban driveway in the morning, a shabby house with peeling paint and a dented garage door behind. A can of black spray paint lies on the ground below the door. The row of A's is so long it runs off the edge of the door."},
  {"id": "a02", "at": 1.45, "kind": "talk", "who": "sarah", "refs": ["sarah"], "key": "Medium shot on the shabby front porch of a house in the morning: the tired woman with a messy brown bun and dark circles under her eyes, in light blue nurse scrubs, holding a coffee mug, stares flatly off to the side at something in the driveway, unimpressed.", "move": "she asks a flat, unimpressed question"},
  {"id": "a03", "at": 3.0, "kind": "talk", "who": "dave", "refs": ["dave"], "key": "Medium close-up in a sunny suburban driveway in the morning, a shabby house with peeling paint and a dented garage door behind: the fat bald man with a brown mustache, in an old olive bomber jacket, a white t-shirt and ripped jeans, holding a can of black spray paint in his right hand, proud and pleased with himself, black paint on his fingers, next to the door of an old rusty pickup truck.", "move": "he answers proudly"},
  {"id": "a04", "at": 4.35, "kind": "still", "refs": ["dave"], "key": "Wide shot of a sunny suburban driveway in the morning, a shabby house with peeling paint and a dented garage door behind: an old rusty pickup truck whose door has a long row of freshly spray-painted black capital letters AAAAAAAAAAAA running across it, the faded words & SON below. the fat bald man with a brown mustache, in an old olive bomber jacket, a white t-shirt and ripped jeans stands next to it posing proudly like in an advertisement, one arm presenting the door, a can of black spray paint raised in his other hand."},
  {"id": "a05", "at": 6.15, "kind": "hold", "refs": ["phantom"], "key": "Close-up: the slim ginger tabby cartoon cat with a big round head, in a black t-shirt sits on the hood of an old rusty pickup truck in a sunny suburban driveway in the morning, a shabby house with peeling paint and a dented garage door behind. He looks straight into the camera with half-closed green eyes and a skeptical, unimpressed face, mouth closed.", "move": "he looks into the camera skeptically and blinks slowly, his ear twitches, his mouth stays closed"},
  {"id": "a06", "at": 8.55, "kind": "talk", "who": "dave", "refs": ["dave"], "key": "Close-up in a sunny suburban driveway in the morning, a shabby house with peeling paint and a dented garage door behind: the fat bald man with a brown mustache, in an old olive bomber jacket, a white t-shirt and ripped jeans, red in the face, shouting angrily off to the side toward the porch, waving a can of black spray paint in his right hand.", "move": "he shouts angrily, waving the spray can"},
  {"id": "a07", "at": 10.85, "kind": "move", "key": "Close-up of a 1970s kitchen table with an orange checkered tablecloth: a fat telephone directory book with a plain yellow cover and no words on it lands on the table. Warm faded 1970s colors like an old printed photo.", "move": "the fat yellow book drops onto the table and bounces once, nothing else moves"},
  {"id": "a08", "at": 12.72, "kind": "move", "key": "Close-up of a fat telephone directory book with plain yellow pages and no words on the cover lying open on a 1970s kitchen table with an orange checkered tablecloth, its thin yellow pages fanning. Warm faded 1970s colors like an old printed photo.", "move": "the thin yellow pages flip fast by themselves, no hands"},
  {"id": "a09", "at": 13.98, "kind": "still", "key": "Extreme close-up of a yellow telephone directory page with the heading GARAGE DOORS in big bold letters at the top and a column of business listings below; a man's finger points at the very first listing. Warm faded 1970s colors like an old printed photo."},
  {"id": "a10", "at": 15.6, "kind": "still", "key": "Close-up of a man's hand dialing an old orange rotary telephone on a 1970s kitchen counter, the yellow directory open beside it. Warm faded 1970s colors like an old printed photo."},
  {"id": "a11", "at": 17.05, "kind": "still", "seed": 11, "key": "Medium shot inside a 1960s telephone company office: a heavyset middle-aged businessman with dark hair and a big chin, in a grey 1960s suit, a white shirt, a black tie and a grey fedora hat, stands at a wooden counter and slides a paper form across it toward a clerk in glasses standing behind it. Warm faded 1960s colors like an old printed photo."},
  {"id": "a12", "at": 19.33, "kind": "hold", "key": "Medium close-up in a 1960s telephone company office: a heavyset middle-aged businessman with dark hair and a big chin, in a grey 1960s suit, a white shirt, a black tie and a grey fedora hat, grins proudly and smugly, leaning on a wooden counter, mouth closed. Warm faded 1960s colors like an old printed photo.", "move": "he grins smugly and raises his eyebrows, his mouth stays closed"},
  {"id": "a13", "at": 21.15, "kind": "still", "key": "Extreme close-up of a typed paper form on a wooden counter: one long line of capital letters AAAAAAAAAAAAAAAAAAAAAAA runs right off the edge of the paper. Warm faded 1960s colors like an old printed photo."},
  {"id": "a14", "at": 22.8, "kind": "still", "key": "Close-up: a clerk in glasses and a white shirt in a 1960s telephone company office slams a rubber stamp onto a paper form; the big red stamped word DENIED. Warm faded 1960s colors like an old printed photo."},
  {"id": "a15", "at": 24.45, "kind": "move", "key": "Wide shot of a wood-paneled 1960s courtroom: an old judge in a black robe at a high bench, a businessman in a grey suit standing at a table below. Warm faded 1960s colors like an old printed photo.", "move": "the judge raises the gavel and brings it down once, the businessman stays still"},
  {"id": "a16", "at": 25.65, "kind": "hold", "seed": 11, "key": "Medium close-up in a 1960s courtroom: a heavyset middle-aged businessman with dark hair and a big chin, in a grey 1960s suit, a white shirt, a black tie and a grey fedora hat, sits slumped at a wooden table in a courtroom, defeated, his face falling, a judge's bench behind him. Warm faded 1960s colors like an old printed photo.", "move": "he slumps in defeat and lowers his head, his mouth stays closed"},
  {"id": "a17", "at": 27.0, "kind": "hold", "key": "Medium shot in a cluttered university office: a nerdy economist with glasses and a sweater vest sits at a desk buried in tall stacks of yellow phone books, an open laptop in front of him, a window behind him showing tall Chicago buildings.", "move": "he looks at the laptop and pushes up his glasses, his mouth stays closed"},
  {"id": "a18", "at": 29.1, "kind": "still", "key": "Wide shot of a city street with tall buildings: a long row of plumbers' work vans parked along the curb, each van a different color."},
  {"id": "a19", "at": 30.25, "kind": "still", "key": "Five plumbers' work vans parked side by side in a city parking lot, seen from the side; the first van in the row is bright red and has the big letters A-1 on its side; the other four vans are plain white."},
  {"id": "a20", "at": 31.85, "kind": "still", "key": "Close-up of the side of a bright red plumber's work van with the big letters A-1 PLUMBING painted on it."},
  {"id": "a21", "at": 33.45, "kind": "move", "key": "A messy office desk: next to a small toy model of a bright red van with A-1 on its side stands a tall wobbling tower of paper complaint folders, while beside four small white toy vans lies one thin folder each.", "move": "the tall tower of folders topples over onto the desk, nothing else moves"},
  {"id": "a22", "at": 35.6, "kind": "still", "refs": ["dave"], "key": "Wide shot of a sunny suburban driveway in the morning, a shabby house with peeling paint and a dented garage door behind: an old rusty pickup truck whose door has a long row of freshly spray-painted black capital letters AAAAAAAAAAAA running across it, the faded words & SON below; the fat bald man with a brown mustache, in an old olive bomber jacket, a white t-shirt and ripped jeans stands next to it looking down at a black smartphone in his right hand, its screen lit with an incoming call."},
  {"id": "a23", "at": 36.9, "kind": "talk", "who": "chuck", "refs": ["chuck"], "key": "Medium close-up in a cluttered back yard: the balding middle-aged man with grey curly hair on the sides, sunglasses pushed up on his bald head, in a white t-shirt and cargo shorts, white socks with sandals, sits in a cheap plastic lawn chair holding a smartphone to his ear, suspicious and blunt.", "move": "he talks on the phone, blunt and suspicious"},
  {"id": "a24", "at": 39.15, "kind": "talk", "who": "dave", "refs": ["dave"], "key": "Close-up in a sunny suburban driveway in the morning, a shabby house with peeling paint and a dented garage door behind: the fat bald man with a brown mustache, in an old olive bomber jacket, a white t-shirt and ripped jeans, holding a black smartphone to his ear with his right hand, his proud face deflating, hesitant.", "move": "he hesitates and answers quietly on the phone"},
  {"id": "a25", "at": 40.6, "kind": "still", "refs": ["dave"], "key": "Wide shot over a chest-high wooden fence between two driveways in the morning. On the LEFT of the fence: the fat bald man with a brown mustache, in an old olive bomber jacket, a white t-shirt and ripped jeans on the phone next to an old rusty pickup truck whose door has a long row of freshly spray-painted black capital letters AAAAAAAAAAAA running across it, the faded words & SON below, in front of a shabby house. On the RIGHT of the fence: a spotless shiny new red pickup truck gleaming in front of a perfect house with a perfect green lawn."},
