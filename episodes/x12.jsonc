// x12 "Speak to the Manager" (script v2, 2026-10-25, docs/x12-speak-to-the-manager.md). Ross: "great, let's do the next one", idea 2 of docs/ideas-small-business-owners.md.
// Chuck demands the manager; Ross ducks under his own counter and comes back up as the manager, the owner and God; God isn't enough either.
// Ross is jack-tyler (as in x08-x11), Chuck jack-chris-boston (as in x10, x11). Line 8 ("...Speaking.") gets an echo in the render, not here.
// Format: see scripts/voice-gen.mjs (lines, directions) and scripts/voice-build.py (cast, plan, gaps, lead, tableSfx). Take k of a line uses direction k.
{
 "title": "Speak to the Manager",
 "cast": {"ross": 1, "chuck": 1},
 "runnerUp": {},
 "lines": [
// he slaps the bell, his face snaps purple
  {"n": 1, "char": "chuck", "text": "I want to speak to the MANAGER!", "dirs": [
   {"t": "[furious] [shouting]", "st": 0.25, "sy": 0.8},
   {"t": "[entitled] [loud]", "st": 0.3, "sy": 0.75},
   {"t": "[outraged] [yelling]", "st": 0.25, "sy": 0.8}
  ]},
// popped up in a clip-on tie
  {"n": 2, "char": "ross", "text": "...Manager.", "dirs": [
   {"t": "[deadpan] [flat]", "st": 0.55, "sy": 0.25},
   {"t": "[tired] [polite]", "st": 0.5, "sy": 0.3},
   {"t": "[monotone] [calm]", "st": 0.55, "sy": 0.25}
  ]},
  {"n": 3, "char": "chuck", "text": "Then the OWNER!", "dirs": [
   {"t": "[demanding] [shouting]", "st": 0.25, "sy": 0.8},
   {"t": "[outraged] [loud]", "st": 0.3, "sy": 0.75},
   {"t": "[yelling] [impatient]", "st": 0.25, "sy": 0.8}
  ]},
// popped up in a crown and a cape, his eye twitching
  {"n": 4, "char": "ross", "text": "...Owner.", "dirs": [
   {"t": "[deadpan] [dignified]", "st": 0.55, "sy": 0.25},
   {"t": "[flat] [tired]", "st": 0.55, "sy": 0.25},
   {"t": "[deadpan] [through gritted teeth]", "st": 0.5, "sy": 0.3}
  ]},
// squinting at him
  {"n": 5, "char": "chuck", "text": "You're the SAME GUY!", "dirs": [
   {"t": "[accusing] [shouting]", "st": 0.3, "sy": 0.75},
   {"t": "[suspicious] [loud]", "st": 0.35, "sy": 0.7},
   {"t": "[outraged] [indignant]", "st": 0.3, "sy": 0.75}
  ]},
  {"n": 6, "char": "ross", "text": "...Small business.", "dirs": [
   {"t": "[deadpan] [tired]", "st": 0.55, "sy": 0.25},
   {"t": "[flat] [matter-of-fact]", "st": 0.55, "sy": 0.25},
   {"t": "[sighing] [resigned]", "st": 0.5, "sy": 0.3}
  ]},
// head thrown back, screaming at the ceiling
  {"n": 7, "char": "chuck", "text": "I want to speak to GOD!", "dirs": [
   {"t": "[screaming] [hysterical]", "st": 0.2, "sy": 0.85},
   {"t": "[enraged] [screaming]", "st": 0.2, "sy": 0.85},
   {"t": "[furious] [shouting]", "st": 0.25, "sy": 0.8}
  ]},
// down on a rope in a bedsheet (echo in the render)
  {"n": 8, "char": "ross", "text": "...Speaking.", "dirs": [
   {"t": "[calm] [deep] [serene]", "st": 0.55, "sy": 0.3},
   {"t": "[booming] [solemn]", "st": 0.5, "sy": 0.35},
   {"t": "[deadpan] [deep voice]", "st": 0.55, "sy": 0.25}
  ]},
// holding up the cup
  {"n": 9, "char": "chuck", "text": "...My latte's cold.", "dirs": [
   {"t": "[petty] [flat]", "st": 0.5, "sy": 0.35},
   {"t": "[whiny] [matter-of-fact]", "st": 0.45, "sy": 0.4},
   {"t": "[sulking] [quiet]", "st": 0.5, "sy": 0.35}
  ]},
// after a sip of the steamed latte
  {"n": 10, "char": "chuck", "text": "...Can I speak to your manager?", "dirs": [
   {"t": "[polite] [unimpressed]", "st": 0.5, "sy": 0.35},
   {"t": "[casual] [flat]", "st": 0.5, "sy": 0.35},
   {"t": "[entitled] [calm]", "st": 0.45, "sy": 0.4}
  ]}
 ],
 "plan": {"1": {"t": 1, "rate": 1.1}, "2": {"t": 1}, "3": {"t": 1}, "4": {"t": 1}, "5": {"t": 1}, "6": {"t": 1}, "7": {"t": 2}, "8": {"t": 2}, "9": {"t": 2, "rate": 1.15}, "10": {"t": 1}},
