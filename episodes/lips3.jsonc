 "gaps": {"1": 0.6, "2": 0.15, "3": 0.15, "4": 0.1, "5": 0.15, "6": 0.25, "7": 0.7, "8": 0.1, "9": 0.6, "10": 0.1, "11": 1.8, "12": 3.2, "13": 2.5},
