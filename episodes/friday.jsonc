   {"t":"[tired] [deadpan]","st":0.5,"sy":0.1},
   {"t":"[half asleep] [flat]","st":0.5,"sy":0.15}
  ]},
  {"n": 7, "char": "phone", "text": "Hi Linda! We can be there in forty minutes. Want to book?", "dirs": [
