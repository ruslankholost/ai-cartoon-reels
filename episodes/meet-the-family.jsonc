// Season 1, episode 1 "Meet the Family" (script approved by Ross 2026-10-19, docs/s1e01-meet-the-family.md v3). Phantom narrates; his
// lines are thoughts (his mouth never moves). Adult tone: the swearing is bleeped in the line files.
// Format: see scripts/voice-gen.mjs (lines, directions) and scripts/voice-build.py (cast, plan, gaps, lead, tableSfx); the picture: scripts/shots.py.
{
 "title": "Meet the Family",
 "cast": {"phantom": 1, "dave": 1, "sarah": 1, "lisa": 1, "chad": 3},
 "lines": [
// evening: the hook, the family, the business
  {"n": 1, "char": "phantom", "text": "I'm Phantom.", "dirs": [
   {"t": "[deadpan] [dry]", "st": 0.5, "sy": 0.25},
   {"t": "[unimpressed] [low]", "st": 0.5, "sy": 0.2},
   {"t": "[bored] [matter-of-fact]", "st": 0.55, "sy": 0.15}
  ]},
  {"n": 2, "char": "phantom", "text": "The only one in this house with a brain.", "dirs": [
   {"t": "[deadpan] [dry]", "st": 0.5, "sy": 0.25, "text": "The only one in this house... with a brain."},
   {"t": "[sarcastic] [unimpressed]", "st": 0.45, "sy": 0.35, "text": "The only one in this house... with a brain."},
   {"t": "[bored] [matter-of-fact]", "st": 0.55, "sy": 0.15, "text": "The only one in this house... with a brain."}
  ]},
  {"n": 3, "char": "phantom", "text": "This is my family.", "dirs": [
   {"t": "[resigned] [dry]", "st": 0.5, "sy": 0.25},
   {"t": "[sighs] [deadpan]", "st": 0.5, "sy": 0.2},
   {"t": "[unimpressed]", "st": 0.5, "sy": 0.25}
  ]},
  {"n": 4, "char": "phantom", "text": "Grandpa built the business.", "dirs": [
   {"t": "[matter-of-fact] [dry]", "st": 0.5, "sy": 0.2},
   {"t": "[deadpan]", "st": 0.5, "sy": 0.2},
   {"t": "[respectful] [dry]", "st": 0.5, "sy": 0.25}
  ]},
  {"n": 5, "char": "phantom", "text": "Dad's running it into the ground.", "dirs": [
   {"t": "[deadpan] [dry]", "st": 0.5, "sy": 0.3},
   {"t": "[sarcastic]", "st": 0.45, "sy": 0.35},
   {"t": "[unimpressed] [flat]", "st": 0.55, "sy": 0.2}
  ]},
  {"n": 6, "char": "sarah", "text": "Dishwasher's dead, Dave.", "dirs": [
   {"t": "[tired] [annoyed]", "st": 0.45, "sy": 0.35},
   {"t": "[exhausted] [sharp]", "st": 0.45, "sy": 0.35},
   {"t": "[fed up]", "st": 0.45, "sy": 0.3}
  ]},
  {"n": 7, "char": "sarah", "text": "We need a new one.", "dirs": [
   {"t": "[tired] [annoyed]", "st": 0.45, "sy": 0.35},
   {"t": "[exhausted] [firm]", "st": 0.45, "sy": 0.3},
   {"t": "[fed up]", "st": 0.45, "sy": 0.3}
  ]},
  {"n": 8, "char": "dave", "text": "With what fucking money?!", "dirs": [
   {"t": "[angry] [shouting]", "st": 0.35, "sy": 0.5},
   {"t": "[irritated] [yelling]", "st": 0.35, "sy": 0.5},
   {"t": "[annoyed] [loud]", "st": 0.4, "sy": 0.45}
  ]},
  {"n": 9, "char": "dave", "text": "Spam.", "dirs": [
   {"t": "[dismissive] [muttering]", "st": 0.5, "sy": 0.2},
   {"t": "[bored] [flat]", "st": 0.55, "sy": 0.15},
   {"t": "[grumbling]", "st": 0.5, "sy": 0.2}
  ]},
  {"n": 10, "char": "phantom", "text": "Yep. You guessed it.", "dirs": [
   {"t": "[deadpan] [dry]", "st": 0.5, "sy": 0.25},
   {"t": "[sarcastic]", "st": 0.45, "sy": 0.35},
   {"t": "[bored] [matter-of-fact]", "st": 0.55, "sy": 0.15}
  ]},
  {"n": 11, "char": "phantom", "text": "My dad's a loser.", "dirs": [
   {"t": "[deadpan] [dry]", "st": 0.5, "sy": 0.25},
   {"t": "[flat] [matter-of-fact]", "st": 0.55, "sy": 0.15},
   {"t": "[sarcastic]", "st": 0.45, "sy": 0.35}
  ]},
  {"n": 12, "char": "sarah", "text": "Everything's on me. Again.", "dirs": [
   {"t": "[exhausted] [bitter] [muttering]", "st": 0.45, "sy": 0.35},
   {"t": "[tired] [sighs]", "st": 0.45, "sy": 0.3, "text": "[sighs] Everything's on me. Again."},
   {"t": "[resentful] [under her breath]", "st": 0.45, "sy": 0.3}
  ]},
// night: Pearl, the want
  {"n": 13, "char": "phantom", "text": "That's Pearl.", "dirs": [
   {"t": "[dreamy] [soft]", "st": 0.4, "sy": 0.45},
   {"t": "[lovestruck] [whispering]", "st": 0.4, "sy": 0.45},
   {"t": "[in awe] [quiet]", "st": 0.45, "sy": 0.4}
  ]},
  {"n": 14, "char": "phantom", "text": "The love of my life.", "dirs": [
   {"t": "[dreamy] [sighing]", "st": 0.4, "sy": 0.45},
   {"t": "[lovestruck] [soft]", "st": 0.4, "sy": 0.45},
   {"t": "[in awe] [quiet]", "st": 0.45, "sy": 0.4}
  ]},
  {"n": 15, "char": "phantom", "text": "She eats salmon.", "dirs": [
   {"t": "[matter-of-fact] [dry]", "st": 0.5, "sy": 0.2},
   {"t": "[envious] [flat]", "st": 0.5, "sy": 0.25},
   {"t": "[deadpan]", "st": 0.5, "sy": 0.2}
  ]},
  {"n": 16, "char": "phantom", "text": "I eat from the dead dog's bowl.", "dirs": [
   {"t": "[deadpan] [bitter]", "st": 0.5, "sy": 0.25},
   {"t": "[flat] [dry]", "st": 0.55, "sy": 0.15},
   {"t": "[resigned]", "st": 0.5, "sy": 0.25}
  ]},
  {"n": 17, "char": "phantom", "text": "God, she's gorgeous.", "dirs": [
   {"t": "[dreamy] [sighing]", "st": 0.4, "sy": 0.5},
   {"t": "[lovestruck] [breathless]", "st": 0.4, "sy": 0.5},
   {"t": "[in awe] [whispering]", "st": 0.4, "sy": 0.45}
  ]},
  {"n": 18, "char": "phantom", "text": "But girls like her don't date cats from broke families.", "dirs": [
   {"t": "[sober] [deadpan]", "st": 0.5, "sy": 0.25, "text": "But girls like her... don't date cats from broke families."},
   {"t": "[disappointed] [flat]", "st": 0.5, "sy": 0.2, "text": "But girls like her... don't date cats from broke families."},
   {"t": "[bitter] [dry]", "st": 0.5, "sy": 0.3, "text": "But girls like her... don't date cats from broke families."}
  ]},
// morning: the fence, the driveways
  {"n": 19, "char": "lisa", "text": "Good morning, Sarah!", "dirs": [
   {"t": "[cheerful] [sweet]", "st": 0.4, "sy": 0.45},
   {"t": "[bright] [singsong]", "st": 0.4, "sy": 0.5},
   {"t": "[warm] [delighted]", "st": 0.4, "sy": 0.45}
  ]},
  {"n": 20, "char": "sarah", "text": "Good morning, Sarah.", "dirs": [
   {"t": "[mocking] [nasal whiny voice]", "st": 0.35, "sy": 0.55},
   {"t": "[sarcastic] [mimicking]", "st": 0.35, "sy": 0.55},
   {"t": "[mocking] [singsong] [bitter]", "st": 0.35, "sy": 0.5}
  ]},
  {"n": 21, "char": "chad", "text": "Morning, Dave!", "dirs": [
   {"t": "[cheerful] [friendly] [calling out]", "st": 0.4, "sy": 0.45},
   {"t": "[upbeat] [warm]", "st": 0.4, "sy": 0.45},
   {"t": "[bright] [loud]", "st": 0.4, "sy": 0.4}
  ]},
  {"n": 22, "char": "chad", "text": "Chad's Garage Doors!", "dirs": [
   {"t": "[cheerful] [professional]", "st": 0.4, "sy": 0.45},
   {"t": "[upbeat] [confident]", "st": 0.4, "sy": 0.45},
   {"t": "[friendly] [bright]", "st": 0.4, "sy": 0.4}
  ]},
  {"n": 23, "char": "dave", "text": "Spam.", "dirs": [
   {"t": "[dismissive] [muttering]", "st": 0.5, "sy": 0.2},
   {"t": "[bitter] [flat]", "st": 0.55, "sy": 0.15},
   {"t": "[grumbling]", "st": 0.5, "sy": 0.2}
  ]},
// the decision and the fixed outro
  {"n": 24, "char": "phantom", "text": "Fine. I'll do it myself.", "dirs": [
   {"t": "[sighs] [resigned] [determined]", "st": 0.45, "sy": 0.3, "text": "[sighs] Fine. I'll do it myself."},
   {"t": "[dry] [determined]", "st": 0.5, "sy": 0.25},
   {"t": "[unimpressed] [decisive]", "st": 0.5, "sy": 0.25}
  ]},
  {"n": 25, "char": "phantom", "text": "Follow, so you don't miss the next episode.", "dirs": [
   {"t": "[dry] [deadpan]", "st": 0.5, "sy": 0.25, "text": "Follow... so you don't miss the next episode."},
   {"t": "[sly] [confident]", "st": 0.45, "sy": 0.35, "text": "Follow... so you don't miss the next episode."},
   {"t": "[matter-of-fact]", "st": 0.5, "sy": 0.2, "text": "Follow... so you don't miss the next episode."}
  ]}
 ],
