 "shots": [
  {"id": "s01", "at": 0.0, "kind": "hold", "refs": ["phantom"], "key": "Close-up: the slim ginger tabby cartoon cat with a big round head and a black t-shirt sits on the arm of a saggy brown couch in a cluttered living room in the evening, mustard yellow walls, warm lamp light. He looks straight into the camera with half-closed green eyes and a smug, unimpressed little smile, his mouth closed.", "move": "he looks into the camera, blinks slowly, his ear twitches, his mouth stays closed"},
  {"id": "s02", "at": 1.12, "kind": "move", "refs": ["dave"], "key": "Wide shot of a cluttered suburban living room in the evening, mustard yellow walls, lamp light. The fat bald man with a brown mustache, in an old olive bomber jacket, a white t-shirt and ripped jeans, sprawls on a saggy brown couch covered in crumbs and candy wrappers, a beer can resting on his big belly, crushed beer cans on the floor, the blue glow of a TV on his face. He burps, cheeks puffed.", "move": "he lets out a big burp, his cheeks puff and his belly jiggles, the beer can wobbles on his belly"},
  {"id": "s03", "at": 4.07, "kind": "hold", "refs": ["dave"], "key": "Close-up: the fat bald man with a brown mustache, in an old olive bomber jacket over a white t-shirt, slumped on a couch, scratches his belly with a TV remote, staring at the TV with dull half-closed eyes, the blue TV glow on his face, a mustard wall behind.", "move": "he stares at the TV and scratches his belly with the remote, his mouth stays closed"},
  {"id": "s04", "at": 5.21, "kind": "hold", "refs": ["sarah"], "key": "Medium close-up in a small kitchen with mustard walls in the evening: the tired woman with a messy brown bun and dark circles under her eyes, in light blue nurse scrubs with a hospital badge, leans on the counter holding a coffee mug, staring into nothing with dead, exhausted eyes.", "move": "she stares blankly and blinks slowly, her mouth stays closed"},
  {"id": "s05", "at": 6.14, "kind": "hold", "refs": ["tyler"], "key": "Medium close-up on a staircase in a shabby house in the evening: the skinny teenage boy with messy brown hair, in a grey hoodie with the hood up, looks down at his smartphone and rolls his eyes with contempt.", "move": "he rolls his eyes and keeps scrolling his phone, his mouth stays closed"},
  {"id": "s06", "at": 7.2, "kind": "still", "key": "Close-up of an old refrigerator door: a faded paper wall calendar from a garage door company with the big words DAVE & SON at the top, open on the year 2009, a small photo of a smiling old man with a gray mustache in an olive bomber jacket giving a thumbs up, fridge magnets."},
  {"id": "s07", "at": 8.92, "kind": "move", "key": "Extreme close-up of a fat hairy hand crushing an empty beer can, the sleeve of an old olive bomber jacket, the blue glow of a TV, a saggy brown couch cushion.", "move": "the hand slowly crushes the empty beer can"},
  {"id": "s08", "at": 10.92, "kind": "talk", "who": "sarah", "refs": ["sarah"], "key": "A small messy kitchen with mustard walls in the evening: the tired woman with a messy brown bun and dark circles under her eyes, in light blue nurse scrubs with a hospital badge, kicks the door of an old dishwasher shut, annoyed, looking off toward the living room.", "move": "she says something sharp and tired, annoyed"},
  {"id": "s09", "at": 13.55, "kind": "move", "key": "Close-up inside an open old dishwasher: dirty plates in the rack, murky grey water standing at the bottom with a fork floating in it.", "move": "the grey water ripples slightly and the fork bobs"},
  {"id": "s10", "at": 15.28, "kind": "talk", "who": "dave", "refs": ["dave"], "key": "Close-up: the fat bald man with a brown mustache, in an old olive bomber jacket, on the couch, eyes glued to the TV, angry and red-faced, shouting without looking away, the blue TV glow on his face.", "move": "he shouts angrily without taking his eyes off the TV"},
  {"id": "s11", "at": 17.15, "kind": "still", "key": "Close-up of a black smartphone lying on a saggy brown couch cushion among crumbs, the screen lit up with an incoming call that says UNKNOWN NUMBER, with a green and a red button.", "fx": "buzz"},
  {"id": "s12", "at": 18.26, "kind": "talk", "who": "dave", "refs": ["dave"], "key": "Close-up: the fat bald man with a brown mustache, in an old olive bomber jacket, on the couch, glances down at a smartphone in his hand with a bored, dismissive face and taps the red decline button with his thumb, the blue TV glow on his face.", "move": "he glances at the phone, mutters one word and taps decline"},
  {"id": "s13", "at": 19.94, "kind": "hold", "refs": ["phantom"], "key": "Close-up: the slim ginger tabby cartoon cat with a big round head, in a black t-shirt, sits on the arm of a couch in an evening living room with mustard walls, looking straight into the camera with a deadpan, unimpressed face, half-closed green eyes, mouth closed.", "move": "he looks into the camera deadpan and blinks once, his mouth stays closed"},
  {"id": "s14", "at": 21.96, "kind": "hold", "refs": ["phantom"], "key": "Extreme close-up of the face of the slim ginger tabby cartoon cat with a big round head, filling the frame, in a cluttered evening living room with mustard yellow walls and warm lamp light behind him: half-closed green eyes, a flat deadpan expression, looking straight into the camera, mouth closed.", "seed": 8, "move": "he stares into the camera without moving, one slow blink, his mouth stays closed"},
  {"id": "s15", "at": 23.94, "kind": "talk", "who": "sarah", "refs": ["sarah"], "key": "A small kitchen with mustard walls in the evening: the tired woman with a messy brown bun and dark circles under her eyes, in light blue nurse scrubs, wearing blue hospital gloves, washes a pile of dirty dishes by hand at the sink, soap foam up to her elbows, a strand of hair stuck to her cheek, bitter and exhausted.", "move": "she scrubs a plate and mutters bitterly"},
  {"id": "s16", "at": 26.75, "kind": "move", "refs": ["phantom", "pearl"], "key": "Night. View from behind the slim ginger tabby cartoon cat with a big round head, sitting on a dark windowsill inside a dark room, the back of his head in the foreground, a book with the word MARKETING lying under his paw. Through the window, across a dark yard and a chest-high wooden fence, the neighbor's window glows warm gold, and in it the fluffy white Persian cat with blue eyes, long eyelashes and a pink collar with a gold heart sits on a pink velvet cushion.", "move": "the cat's tail sways slowly, the gold window glows, the white cat in it sits still"},
  {"id": "s17", "at": 28.79, "kind": "hold", "refs": ["pearl"], "key": "Close-up: the fluffy white Persian cat with blue eyes, long eyelashes and a pink collar with a gold heart sits on a pink velvet cushion in a warm gold-lit room, elegant, eyes half-closed in a slow blink.", "move": "she blinks slowly and elegantly, her mouth stays closed"},
  {"id": "s18", "at": 30.44, "kind": "hold", "refs": ["phantom"], "key": "Night, close-up: the slim ginger tabby cartoon cat with a big round head, in a black t-shirt, on a dark windowsill, lovestruck, with big pink hearts in his eyes and a dreamy smile, the warm gold light from the neighbor's window on his face.", "move": "he sighs dreamily, the hearts in his eyes pulse, his mouth stays closed"},
