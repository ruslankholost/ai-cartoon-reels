   {"t": "[furious] [shouting]", "st": 0.25, "sy": 0.8},
   {"t": "[outraged] [emphatic]", "st": 0.25, "sy": 0.8},
   {"t": "[enraged] [lecturing]", "st": 0.3, "sy": 0.75}
  ]},
// a shrug, still smiling
  {"n": 4, "char": "chuck", "text": "Nobody's perfect.", "dirs": [
   {"t": "[casual] [cheerful]", "st": 0.45, "sy": 0.5},
   {"t": "[light] [shrugging]", "st": 0.45, "sy": 0.5},
   {"t": "[friendly] [matter-of-fact]", "st": 0.5, "sy": 0.45}
  ]},
// setting down the big latte with Chuck's face in the foam, beaming too hard
  {"n": 5, "char": "ross", "text": "On the house.", "dirs": [
   {"t": "[sweet] [forced cheerful]", "st": 0.4, "sy": 0.5},
   {"t": "[hopeful] [eager]", "st": 0.4, "sy": 0.5},
   {"t": "[overly friendly]", "st": 0.35, "sy": 0.55}
  ]},
// after a sip, a foam mustache, thinking it over
  {"n": 6, "char": "chuck", "text": "...Four.", "dirs": [
   {"t": "[thoughtful] [flat]", "st": 0.55, "sy": 0.3},
   {"t": "[deadpan] [calm]", "st": 0.55, "sy": 0.3},
   {"t": "[considering] [dry]", "st": 0.5, "sy": 0.35}
  ]},
// on one knee, the ring box open, his hands shaking
  {"n": 7, "char": "ross", "text": "JUST PRESS FIVE!!", "dirs": [
   {"t": "[desperate] [pleading]", "st": 0.25, "sy": 0.8},
   {"t": "[begging] [shouting]", "st": 0.25, "sy": 0.8},
   {"t": "[hysterical] [pleading]", "st": 0.2, "sy": 0.85}
  ]},
// a polite, flat no
  {"n": 8, "char": "chuck", "text": "...I'm good.", "dirs": [
   {"t": "[polite] [flat]", "st": 0.55, "sy": 0.3},
   {"t": "[casual] [dismissive]", "st": 0.5, "sy": 0.35},
   {"t": "[deadpan] [calm]", "st": 0.55, "sy": 0.3}
  ]},
// squatting on Chuck's chest, the phone held up high, confetti
  {"n": 9, "char": "ross", "text": "FIVE STARS!!", "dirs": [
   {"t": "[triumphant] [shouting]", "st": 0.2, "sy": 0.85},
   {"t": "[manic] [victorious]", "st": 0.2, "sy": 0.85},
   {"t": "[ecstatic] [yelling]", "st": 0.25, "sy": 0.8}
  ]},
// flat on the floor, typing with one thumb, reading it out as he types
  {"n": 10, "char": "chuck", "text": "Great coffee... owner tackled me.", "dirs": [
   {"t": "[flat] [reading aloud]", "st": 0.55, "sy": 0.3},
   {"t": "[deadpan] [dry]", "st": 0.55, "sy": 0.3},
   {"t": "[calm] [matter-of-fact]", "st": 0.5, "sy": 0.35}
