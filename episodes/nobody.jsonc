// "Nobody Picks Up" (script v2 approved by Ross 2026-10-20, docs/x01-nobody-picks-up.md). New direction: a composite of owners, drawn in code.
// Format: see scripts/voice-gen.mjs (lines, directions) and scripts/voice-build.py (cast, plan, gaps, lead, tableSfx).
{
 "title": "Nobody Picks Up",
 "cast": {"denise": 1, "tony": 1, "voicemail": 1, "agency": 1, "marco": 1, "wife": 1, "gary": 1},
 "runnerUp": {},
 "lines": [
// head: the shower goes ice cold
  {"n": 1, "char": "denise", "text": "Oh, you're fucking kidding me.", "dirs": [
   {"t": "[shrieking] [furious]", "st": 0.3, "sy": 0.5},
   {"t": "[gasping] [outraged]", "st": 0.3, "sy": 0.5},
   {"t": "[shocked] [yelling]", "st": 0.35, "sy": 0.45}
  ]},
  {"n": 2, "char": "denise", "text": "Five stars. Come on.", "dirs": [
   {"t": "[shivering] [impatient]", "st": 0.4, "sy": 0.4},
   {"t": "[teeth chattering] [muttering]", "st": 0.4, "sy": 0.35},
   {"t": "[cold] [urgent]", "st": 0.4, "sy": 0.4}
  ]},
// AquaPro: under a sink
  {"n": 3, "char": "tony", "text": "Not now.", "dirs": [
   {"t": "[muffled] [straining]", "st": 0.45, "sy": 0.3},
   {"t": "[grunting] [annoyed]", "st": 0.45, "sy": 0.3},
   {"t": "[strained] [muttering]", "st": 0.5, "sy": 0.25}
  ]},
  {"n": 4, "char": "voicemail", "text": "Thanks for calling AquaPro, we'll get right back to you", "dirs": [
   {"t": "[cheerful] [recorded message]", "st": 0.6, "sy": 0.3, "text": "Thanks for calling AquaPro! We'll get right back to..."},
   {"t": "[bright] [customer service voice]", "st": 0.6, "sy": 0.3, "text": "Thanks for calling AquaPro! We'll get right back to..."},
   {"t": "[cheerful] [professional]", "st": 0.7, "sy": 0.2, "text": "Thanks for calling AquaPro, we'll get right back to..."}
  ]},
// Premier: the agency meeting
  {"n": 5, "char": "agency", "text": "What you need is more leads.", "dirs": [
   {"t": "[confident] [salesy]", "st": 0.35, "sy": 0.5},
   {"t": "[smug] [matter-of-fact]", "st": 0.4, "sy": 0.45},
   {"t": "[enthusiastic] [pitching]", "st": 0.35, "sy": 0.55}
  ]},
  {"n": 6, "char": "marco", "text": "Sorry. Go on.", "dirs": [
   {"t": "[polite] [distracted]", "st": 0.5, "sy": 0.2},
   {"t": "[casual] [dismissive]", "st": 0.5, "sy": 0.2},
   {"t": "[friendly] [quick]", "st": 0.45, "sy": 0.25}
  ]},
// Flow Bros: the school show
  {"n": 7, "char": "wife", "text": "Rick.", "dirs": [
   {"t": "[hissing] [whispering] [furious]", "st": 0.45, "sy": 0.4},
   {"t": "[angry whisper]", "st": 0.45, "sy": 0.35},
   {"t": "[whispering] [through gritted teeth]", "st": 0.45, "sy": 0.4}
  ]},
// the turn: Gary
  {"n": 8, "char": "denise", "text": "Fine. Gary.", "dirs": [
   {"t": "[defeated] [sighing]", "st": 0.45, "sy": 0.3, "text": "...Fine. Gary."},
   {"t": "[resigned] [flat]", "st": 0.5, "sy": 0.2, "text": "...Fine. Gary."},
   {"t": "[reluctant] [muttering]", "st": 0.45, "sy": 0.3, "text": "Fine... Gary."}
  ]},
  {"n": 9, "char": "gary", "text": "Yeah.", "dirs": [
   {"t": "[mouth full] [chewing]", "st": 0.45, "sy": 0.3},
   {"t": "[bored] [chewing]", "st": 0.5, "sy": 0.2},
   {"t": "[gruff] [mouth full]", "st": 0.45, "sy": 0.3}
  ]},
  {"n": 10, "char": "denise", "text": "Hi, my water heater died, how soon can", "dirs": [
   {"t": "[rushed] [hopeful]", "st": 0.35, "sy": 0.45, "text": "Hi! My water heater died, how soon can..."},
   {"t": "[eager] [fast]", "st": 0.35, "sy": 0.45, "text": "Hi, my water heater died, how soon can..."},
   {"t": "[relieved] [rushed]", "st": 0.4, "sy": 0.4, "text": "Hi! My water heater died, how soon can..."}
  ]},
  {"n": 11, "char": "gary", "text": "Fifteen hundred.", "dirs": [
   {"t": "[flat] [chewing]", "st": 0.5, "sy": 0.2},
   {"t": "[blunt] [bored]", "st": 0.5, "sy": 0.2},
   {"t": "[deadpan]", "st": 0.55, "sy": 0.15}
  ]},
  {"n": 12, "char": "denise", "text": "For what?", "dirs": [
   {"t": "[shocked] [indignant]", "st": 0.35, "sy": 0.45},
   {"t": "[outraged]", "st": 0.35, "sy": 0.5},
   {"t": "[incredulous]", "st": 0.4, "sy": 0.4}
  ]},
  {"n": 13, "char": "gary", "text": "I picked up.", "dirs": [
   {"t": "[deadpan] [chewing]", "st": 0.55, "sy": 0.15},
   {"t": "[flat] [matter-of-fact]", "st": 0.55, "sy": 0.15},
   {"t": "[smug] [slow]", "st": 0.5, "sy": 0.25}
  ]},
  {"n": 14, "char": "denise", "text": "Okay. Come.", "dirs": [
   {"t": "[defeated] [quietly]", "st": 0.5, "sy": 0.2, "text": "...Okay. Come."},
   {"t": "[resigned] [sighing]", "st": 0.5, "sy": 0.25, "text": "...Okay. Come."},
   {"t": "[broken] [flat]", "st": 0.55, "sy": 0.15, "text": "...okay. Come."}
  ]},
  {"n": 15, "char": "gary", "text": "And leave me five stars, yeah?", "dirs": [
   {"t": "[casual] [chewing]", "st": 0.5, "sy": 0.2},
   {"t": "[smug] [lazy]", "st": 0.5, "sy": 0.25},
   {"t": "[cheeky] [mouth full]", "st": 0.45, "sy": 0.3}
  ]},
// tail: the evening, she types the review
  {"n": 16, "char": "denise", "text": "He picked up.", "dirs": [
   {"t": "[flat] [tired]", "st": 0.55, "sy": 0.15},
   {"t": "[deadpan] [quietly]", "st": 0.55, "sy": 0.15},
   {"t": "[resigned] [typing]", "st": 0.5, "sy": 0.2}
  ]}
 ],
// picked by the numbers (voice-analyze.py) and Whisper (voice-check.py), not by ear: the loudest "Oh", the shortest cold lines, the slow
// deadpan "I picked up." (t1, 1.6 s) over the quick one. Gary = jack-chris-boston (Callum, the runner-up, was Dave in the pilot).
// The voicemail adds "you" whatever the text says, so its line reads "...back to you"; Denise hangs up on it.
 "plan": {
  "1": {"t": 3, "bleep": [2]}, "2": {"t": 3}, "3": {"t": 3}, "4": {"t": 3}, "5": {"t": 3}, "6": {"t": 3}, "7": {"t": 3}, "8": {"t": 2},
  "9": {"t": 1}, "10": {"t": 2}, "11": {"t": 2}, "12": {"t": 2}, "13": {"t": 1}, "14": {"t": 1}, "15": {"t": 2}, "16": {"t": 1}
 },
 "lead": 0.3,
// the long gaps carry the silent shots (docs/x01 shot list): 2 -> 3 the tap and the ring, 4 -> 5 the hang-up, the tap, the office,
// 6 -> 7 Denise shivering and the toilet-flush ringtone in the gym, 7 -> 8 the scroll, 8 -> 9 the tap and half a ring,
// 10 -> 11 Gary cuts her off, 12 -> 13 the slow-mo beat, 13 -> 14 the foam drip; after 15 the evening tail (about 4.8 s)
 "gaps": {"1": 0.3, "2": 1.4, "3": 0.6, "4": 1.0, "5": 0.5, "6": 2.4, "7": 1.8, "8": 0.9, "9": 0.3, "10": 0.0, "11": 0.3, "12": 0.5, "13": 1.0, "14": 0.3, "15": 2.0},
