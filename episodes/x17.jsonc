 ],
// takes picked from voice-analyze and Whisper (all 42 heard; the DIFFs are spellings: "Hi" for "Hiii", "Leg rooms" for "Legroom's"): the quickest "Window seat." for the hook, the groom's low goofy "Hiii!",
// "...Sure." through gritted teeth, the flattest "It's a bird.", the screamed "THAT WINDOW!" with the widest range, the pilot's lazy sigh without the double "Ah"
 "plan": {"1": {"t": 2, "rate": 1.1}, "2": {"t": 2}, "3": {"t": 3}, "4": {"t": 1, "rate": 1.15}, "5": {"t": 2, "rate": 1.1}, "6": {"t": 2, "rate": 1.15}, "7": {"t": 1, "rate": 1.1}, "8": {"t": 1, "rate": 1.05}, "9": {"t": 2, "rate": 1.1}, "10": {"t": 2}, "11": {"t": 2}, "12": {"t": 1}, "13": {"t": 2}, "14": {"t": 3}},
