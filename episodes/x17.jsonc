   {"t": "[chipper] [loud]", "st": 0.4, "sy": 0.55},
   {"t": "[bright] [projecting]", "st": 0.45, "sy": 0.5}
  ]},
// on the wing, pointing at window 12A, the couple kissing behind it
  {"n": 10, "char": "ross", "text": "I PAID FOR THAT WINDOW!", "dirs": [
