   {"t": "[cheerful] [eager]", "st": 0.4, "sy": 0.6}
  ]},
// sweet, the honeymoon card played
  {"n": 4, "char": "bride", "text": "Would you swap with us? It's our honeymoon.", "dirs": [
   {"t": "[sweet] [pleading]", "st": 0.45, "sy": 0.5},
   {"t": "[cute] [begging]", "st": 0.4, "sy": 0.55},
   {"t": "[bubbly] [entitled]", "st": 0.45, "sy": 0.5}
  ]},
// the eye twitches; he hates it and says yes
  {"n": 5, "char": "ross", "text": "...Sure.", "dirs": [
   {"t": "[forced] [strained]", "st": 0.5, "sy": 0.4},
   {"t": "[reluctant] [through gritted teeth]", "st": 0.5, "sy": 0.4},
   {"t": "[defeated] [quiet]", "st": 0.55, "sy": 0.35}
  ]},
// row 47, the frozen airline smile, the peacock behind her
  {"n": 6, "char": "fa", "text": "Sir? His support peacock needs a seat.", "dirs": [
