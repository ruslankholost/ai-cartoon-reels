   {"t": "[polite] [overly bright]", "st": 0.45, "sy": 0.5},
   {"t": "[professional] [sweet]", "st": 0.5, "sy": 0.45}
  ]},
// flat, a vein on his forehead, the tail in his face
  {"n": 7, "char": "ross", "text": "It's a bird.", "dirs": [
   {"t": "[flat] [deadpan]", "st": 0.55, "sy": 0.3},
   {"t": "[exasperated] [dry]", "st": 0.5, "sy": 0.4},
   {"t": "[through gritted teeth] [flat]", "st": 0.55, "sy": 0.35}
  ]},
// she pulls the emergency exit's handle and gestures out like a waiter
  {"n": 8, "char": "fa", "text": "We found you something with a view!", "dirs": [
   {"t": "[cheerful] [overly helpful]", "st": 0.4, "sy": 0.55},
   {"t": "[bright] [proud]", "st": 0.4, "sy": 0.55},
   {"t": "[sweet] [sales pitch]", "st": 0.45, "sy": 0.5}
  ]},
// leaning out of the exit into the wind, smile frozen
  {"n": 9, "char": "fa", "text": "Legroom's thirty-nine ninety-nine!", "dirs": [
