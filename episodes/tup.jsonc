   {"t": "[wry] [conversational] [unhurried]", "st": 0.5, "sy": 0.25},
   {"t": "[matter-of-fact] [amused]", "st": 0.45, "sy": 0.3}
  ]},
  {"n": 7, "char": "rhonda", "text": "Nobody gets the lid. You have to burp it.", "dirs": [
