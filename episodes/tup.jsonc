// the story (sepia): Rhonda over the pictures
  {"n": 5, "char": "rhonda", "text": "Detroit, 1949. Plastic bowls.", "dirs": [
   {"t": "[dry] [casual] [storytelling]", "st": 0.45, "sy": 0.25},
