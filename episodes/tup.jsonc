   {"t": "[dry] [matter-of-fact] [storytelling]", "st": 0.5, "sy": 0.2},
   {"t": "[casual] [wry] [storytelling]", "st": 0.45, "sy": 0.3}
  ]},
  {"n": 8, "char": "rhonda", "text": "So a divorced mom named Brownie Wise shows 'em at parties.", "dirs": [
