# Copy this file to .env and fill in the values. .env is in .gitignore: never commit it.
# One KEY=value per line, no quotes, saved as UTF-8 (a UTF-16 file breaks scripts/voices.mjs and scripts/voice-gen.mjs).

# ElevenLabs: voices (scripts/voices.mjs, scripts/voice-gen.mjs), sound effects and music (scripts/sfx-gen.mjs)
ELEVENLABS_API_KEY=

# Anthropic: optional. Only scripts/writers-room.mjs and the defect check in scripts/shots.py read it.
ANTHROPIC_API_KEY=
